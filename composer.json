{
    "name": "appfoster/upsnap",
    "description": "Monitoring & analytics plugin for Craft CMS sites.",
    "type": "craft-plugin",
    "keywords": [
        "craft",
        "cms",
        "craftcms",
        "craft-plugin",
        "upsnap-plugin",
        "monitoring",
        "monitor",
        "watcher",
        "watch",
        "upsnap",
        "analytics",
        "upsnap plugin for craft"
    ],
    "support": {
        "docs": "https://github.com/Appfoster/upsnap/wiki",
        "issues": "https://github.com/Appfoster/upsnap/issues"
    },
    "license": "proprietary",
    "authors": [
        {
            "name": "Appfoster",
            "homepage": "https://www.appfoster.com/"
        }
    ],
    "require": {
        "craftcms/cms": "^6.0.0-alpha.1"
    },
    "autoload": {
        "psr-4": {
            "appfoster\\upsnap\\": "src/"
        }
    },
    "extra": {
        "name": "Upsnap",
        "handle": "upsnap",
        "hasCpSection": true,
        "changelogUrl": "https://github.com/Appfoster/upsnap/blob/master/CHANGELOG.md",
        "documentationUrl": "https://github.com/Appfoster/upsnap/wiki",
        "class": "appfoster\\upsnap\\Upsnap"
    },
    "config": {
        "allow-plugins": {
            "craftcms/plugin-installer": true
        }
    }
}