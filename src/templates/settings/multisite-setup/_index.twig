{% extends "_layouts/cp" %}

{% set crumbs = [
    { html: "<a href='" ~ url('upsnap') ~ "' class='thumb cp-icon'><svg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 576 512' focusable='false' aria-hidden='true'><path d='M575.8 255.5c0 18-15 32.1-32 32.1l-32 0 .7 160.2c0 2.7-.2 5.4-.5 8.1l0 16.2c0 22.1-17.9 40-40 40l-16 0c-1.1 0-2.2 0-3.3-.1c-1.4 .1-2.8 .1-4.2 .1L416 512l-24 0c-22.1 0-40-17.9-40-40l0-24 0-64c0-17.7-14.3-32-32-32l-64 0c-17.7 0-32 14.3-32 32l0 64 0 24c0 22.1-17.9 40-40 40l-24 0-31.9 0c-1.5 0-3-.1-4.5-.2c-1.2 .1-2.4 .2-3.6 .2l-16 0c-22.1 0-40-17.9-40-40l0-112c0-.9 0-1.9 .1-2.8l0-69.7-32 0c-18 0-32-14-32-32.1c0-9 3-17 10-24L266.4 8c7-7 15-8 22-8s15 2 21 7L564.8 231.5c8 7 12 15 11 24z'></path></svg></a>" },
    { label: "Settings"|t('upsnap'), url: settingsUrl },
] %}

{% set activeSites        = activeSites        ?? [] %}
{% set excludedSites      = excludedSites      ?? [] %}
{% set userDetails        = userDetails        ?? null %}
{% set monitorCheckFailed = monitorCheckFailed ?? false %}

{# Plan limit calculation #}
{% set planLimit      = userDetails.plan_limits.monitors ?? null %}
{% set currentCount   = userDetails.monitors_count ?? null %}
{% set remainingSlots = planLimit is not null and currentCount is not null ? (planLimit - currentCount) : null %}
{% set newSitesCount  = activeSites|filter(s => not s.alreadyMonitored)|length %}

{% block actionButton %}
    <div class="flex smallgap">
        <a href="{{ settingsUrl }}" class="btn">{{ "Skip for Now"|t('upsnap') }}</a>
        {% if newSitesCount > 0 %}
            <button type="button" id="upsnap-multisite-submit" class="btn submit">
                {{ "Create Monitors"|t('upsnap') }}
            </button>
        {% endif %}
    </div>
{% endblock %}

{% block content %}

    {# ── Server data + i18n injected for multisiteSetup.js ── #}
    <script>
        window.UpsnapMultisite = {
            bulkCreateUrl:  {{ actionUrl('upsnap/settings/bulk-create-monitors')|json_encode|raw }},
            csrfTokenName:  {{ '_token'|json_encode|raw }},
            csrfTokenValue: {{ csrf_token()|json_encode|raw }},
            monitorsUrl:    {{ monitorsUrl|json_encode|raw }},
            settingsUrl:    {{ settingsUrl|json_encode|raw }},
            i18n: {
                selectAtLeastOne:     {{ "Please select at least one site."|t('upsnap')|json_encode|raw }},
                noValidUrls:          {{ "No valid URLs found for selected sites."|t('upsnap')|json_encode|raw }},
                creating:             {{ "Creating…"|t('upsnap')|json_encode|raw }},
                anErrorOccurred:      {{ "An error occurred."|t('upsnap')|json_encode|raw }},
                sessionExpiredPrompt: {{ "Your session may have expired. Go to Settings to re-authenticate?"|t('upsnap')|json_encode|raw }},
                createMonitors:       {{ "Create Monitors"|t('upsnap')|json_encode|raw }},
                created:              {{ "created"|t('upsnap')|json_encode|raw }},
                skippedAlreadyExists: {{ "skipped (already exists)"|t('upsnap')|json_encode|raw }},
                failed:               {{ "failed"|t('upsnap')|json_encode|raw }},
                doneGoToMonitors:     {{ "Done - Go to Monitors"|t('upsnap')|json_encode|raw }},
                unexpectedError:      {{ "An unexpected error occurred. Please try again."|t('upsnap')|json_encode|raw }},
                statusCreated:        {{ "Created"|t('upsnap')|json_encode|raw }},
                statusSkipped:        {{ "Skipped"|t('upsnap')|json_encode|raw }},
                statusFailed:         {{ "Failed"|t('upsnap')|json_encode|raw }},
            },
        };
    </script>

    {# ── Duplicate-check failure notice ── #}
    {% if monitorCheckFailed %}
        <div class="status-container warning" style="margin-bottom: 16px;">
            <div class="status-header">
                <div class="status-icon warning">!</div>
                <h3 class="status-title">{{ "Could Not Check Existing Monitors"|t('upsnap') }}</h3>
            </div>
            <p class="status-message-dashboard">
                {{ "We couldn't verify which sites are already being monitored. Duplicate monitors will be caught by the API, but you may see individual errors for sites that already exist."|t('upsnap') }}
            </p>
        </div>
    {% endif %}

    {# ── Plan limit warning ── #}
    {% if remainingSlots is not null and newSitesCount > remainingSlots %}
        <div class="status-container warning" style="margin-bottom: 16px;">
            <div class="status-header">
                <div class="status-icon warning">!</div>
                <h3 class="status-title">{{ "Monitor Limit"|t('upsnap') }}</h3>
            </div>
            <p class="status-message-dashboard">
                {{ "Your plan allows {limit} monitor(s). You currently have {current}, leaving {remaining} slot(s). You have selected {selected} site(s) - some may not be created."|t('upsnap', {
                    limit:     planLimit,
                    current:   currentCount,
                    remaining: remainingSlots,
                    selected:  newSitesCount
                }) }}
            </p>
        </div>
    {% endif %}

    {# ── Excluded sites notice ── #}
    {% if excludedSites|length > 0 %}
        <div class="status-container warning" style="margin-bottom: 16px;">
            <div class="status-header">
                <div class="status-icon warning">!</div>
                <h3 class="status-title">
                    {{ "{count} site(s) excluded from setup"|t('upsnap', { count: excludedSites|length }) }}
                </h3>
            </div>
            <p class="status-message-dashboard">{{ "The following sites cannot be monitored and were excluded:"|t('upsnap') }}</p>
            <ul style="margin: 8px 0 0 20px; list-style: disc;">
                {% for site in excludedSites %}
                    <li>
                        <strong>{{ site.name }}</strong>
                        {% if site.skipReason == 'no_url' %}
                            - {{ "no base URL configured"|t('upsnap') }}
                            (<a href="{{ cpUrl('settings/sites/' ~ site.id) }}">{{ "Fix in Craft Sites settings"|t('upsnap') }}</a>)
                        {% elseif site.skipReason == 'unresolvable_env' %}
                            - {{ "environment variable {var} could not be resolved"|t('upsnap', { var: site.baseUrl }) }}
                        {% elseif site.skipReason == 'invalid_url' %}
                            - {{ "URL {url} is not a valid absolute URL"|t('upsnap', { url: site.baseUrl }) }}
                        {% endif %}
                    </li>
                {% endfor %}
            </ul>
        </div>
    {% endif %}

    {# ── No usable sites at all ── #}
    {% if activeSites|length == 0 %}

        <div class="status-container warning">
            <div class="status-header">
                <div class="status-icon warning">!</div>
                <h3 class="status-title">{{ "No Monitorable Sites Found"|t('upsnap') }}</h3>
            </div>
            <p class="status-message-dashboard">
                {{ "None of your Craft sites have a valid absolute URL configured. Please set base URLs in Craft > Settings > Sites, then return here."|t('upsnap') }}
            </p>
            <a href="{{ cpUrl('settings/sites') }}" class="btn" style="margin-top: 8px;">
                {{ "Go to Craft Sites Settings"|t('upsnap') }}
            </a>
        </div>

    {% else %}

        <div class="status-container" style="margin-bottom: 24px;">
            <p class="status-message-dashboard">
                {{ "We detected {count} site(s) in your Craft multi-site setup. Select the sites you'd like to monitor and confirm the monitor names below."|t('upsnap', { count: activeSites|length }) }}
            </p>
        </div>

        <div id="upsnap-multisite-results" style="display:none; margin-bottom: 24px;"></div>

        <table class="data fullwidth" id="upsnap-multisite-table">
            <thead>
                <tr>
                    <th class="thin">
                        <input type="checkbox" id="upsnap-select-all" checked title="{{ 'Select/deselect all'|t('upsnap') }}">
                    </th>
                    <th>{{ "Monitor Name"|t('upsnap') }}</th>
                    <th>{{ "Site URL"|t('upsnap') }}</th>
                    <th>{{ "Status"|t('upsnap') }}</th>
                </tr>
            </thead>
            <tbody>
                {% for site in activeSites %}
                    <tr id="upsnap-site-{{ site.id }}" data-url="{{ site.resolvedUrl }}">
                        <td>
                            <input
                                type="checkbox"
                                class="upsnap-site-checkbox"
                                data-site-id="{{ site.id }}"
                                {{ site.alreadyMonitored ? 'disabled checked' : 'checked' }}
                            >
                        </td>
                        <td>
                            <input
                                type="text"
                                class="text upsnap-site-name"
                                data-site-id="{{ site.id }}"
                                value="{{ site.name }}"
                                {{ site.alreadyMonitored ? 'disabled' : '' }}
                                style="width: 100%;"
                            >
                        </td>
                        <td>
                            <code>{{ site.resolvedUrl }}</code>
                            {% if site.isEnvVar %}
                                <span class="pill pill--yellow" style="margin-left: 6px;"
                                      title="{{ 'Resolved from environment variable: {var}'|t('upsnap', { var: site.baseUrl }) }}">
                                    {{ "env var"|t('upsnap') }}
                                </span>
                                <p class="light" style="font-size: 11px; margin: 2px 0 0 0;">
                                    {{ "Resolved from {var} - please verify this URL is correct before creating the monitor."|t('upsnap', { var: site.baseUrl }) }}
                                </p>
                            {% endif %}
                        </td>
                        <td>
                            {% if site.alreadyMonitored %}
                                <span class="pill pill--green">{{ "Already monitored"|t('upsnap') }}</span>
                            {% else %}
                                <span class="pill" id="status-{{ site.id }}">{{ "Ready"|t('upsnap') }}</span>
                            {% endif %}
                        </td>
                    </tr>
                {% endfor %}
            </tbody>
        </table>

        <p style="margin-top: 16px;">
            <a href="{{ monitorsUrl }}" class="light">{{ "Skip and go to Monitors"|t('upsnap') }}</a>
        </p>

    {% endif %}

{% endblock %}
